# Environment variables for the contact form. Copy to `.env` and fill in.
#
# NO VALUES ARE COMMITTED HERE — this file exists so a deploy knows WHICH keys
# it needs. `.env` itself is gitignored, so without this file the required set
# is recorded nowhere and the first production deploy finds out by failing.
#
# The contact form is the only thing on this site that reads any of these. If
# they are wrong, `POST /api/email` returns 500 and the form shows its fallback
# message; nothing else on the site notices.

# ── REQUIRED ────────────────────────────────────────────────────────────────

# The mailbox the site SENDS FROM, and — unless CONTACT_TO is set below — the
# mailbox enquiries are delivered TO. Read the CONTACT_TO note before assuming
# those are the same thing you want.
#
# This is NOT the address printed on the site. That one is CONTACT.email in
# src/content/site.ts and is public; this one is a credentialed account.
SMTP_EMAIL=

# App password for SMTP_EMAIL. For a Google account this is a 16-character App
# Password, not the account password — Google rejects the account password for
# SMTP regardless of what else is configured.
SMTP_TOKEN=

# ── OPTIONAL, WITH DEFAULTS THAT ALREADY WORK ───────────────────────────────

# Defaults to smtp.gmail.com / 465 with ssl: true (route.ts:420-422).
#
# The defaults are correct for Google Workspace as well as consumer Gmail —
# arcompsol.com's MX records point at aspmx.l.google.com, so a domain mailbox
# still sends through smtp.gmail.com. Leave these unset unless you move off
# Google entirely.
SMTP_HOST=
SMTP_PORT=

# WHERE ENQUIRIES LAND. Falls back to SMTP_EMAIL when unset (route.ts:58).
#
# READ THIS BEFORE THE PRODUCTION DEPLOY. The site prints CONTACT.email on
# every page, so somebody who emails by hand reaches that address — but the
# contact form delivers to SMTP_EMAIL unless this is set. Leave it unset only
# if you actually read the SMTP_EMAIL mailbox; otherwise form submissions go
# somewhere nobody is looking, and the form will report success while doing it.
CONTACT_TO=

# Extra recipients, comma-separated. Unset means none.
CONTACT_CC=
