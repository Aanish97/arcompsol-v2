# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env*.local

# ...except the template, which carries KEY NAMES ONLY and no values. Without
# this negation `.env*` above swallows it and the one file that records what a
# deploy needs is silently never committed. Keep the negation after the rule it
# reverses; git applies the last matching pattern.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
